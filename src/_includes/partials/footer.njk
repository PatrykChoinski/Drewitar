<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/"><img class="logo-img" src="/assets/img/logo.webp" alt="Drewitar Kamil Kocemba" width="480" height="230" loading="lazy"></a>
        <p>{{ company.tagline }}. Klienci indywidualni i firmy.</p>
      </div>
      <div>
        <h2>Kontakt</h2>
        <address>
          {{ company.street }}<br>{{ company.postalCode }} {{ company.city }}<br>
          {% for p in company.phones %}<a href="tel:{{ p.tel }}">{{ p.display }}</a><br>{% endfor %}
        </address>
      </div>
      <div>
        <h2>Oferta</h2>
        <ul>
          {% for p in products.slice(0, 5) %}<li><a href="/oferta/{{ p.slug }}/">{{ p.name }}</a></li>{% endfor %}
        </ul>
      </div>
      <div>
        <h2>Na skróty</h2>
        <ul>
          <li><a href="/kontakt/#wycena">Wycena</a></li>
          <li><a href="{{ company.facebook }}" rel="noopener" target="_blank">Facebook</a></li>
          <li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li>
          <li><a href="/zrodla-zdjec/">Źródła zdjęć</a></li>
        </ul>
      </div>
    </div>
    <div class="copy"><span>© {{ site.year }} {{ company.name }}</span><span>NIP {{ company.nip }}</span></div>
  </div>
</footer>
