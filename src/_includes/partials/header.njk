{% set nav = [
  { url: "/", label: "Start" },
  { url: "/oferta/", label: "Oferta" },
  { url: "/uslugi/", label: "Usługi" },
  { url: "/galeria/", label: "Galeria" },
  { url: "/o-firmie/", label: "O firmie" },
  { url: "/kontakt/", label: "Kontakt" }
] %}
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      <img class="logo-img" src="/assets/img/logo.webp" alt="Drewitar Kamil Kocemba" width="480" height="230">
      <span class="logo-sub">tartak<br>skład drewna</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="sr-only">Menu</span><span class="burger" aria-hidden="true"></span>
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Główna nawigacja">
      <ul>
        {% for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
        <li><a class="btn btn-small" href="/kontakt/#wycena">Bezpłatna wycena</a></li>
      </ul>
    </nav>
  </div>
</header>
