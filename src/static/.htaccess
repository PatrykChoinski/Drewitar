# Drewitar – konfiguracja serwera Hostido (LiteSpeed/Apache)
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://drewitar.pl%{REQUEST_URI} [R=301,L]
  # www -> bez www
  RewriteCond %{HTTP_HOST} ^www\.drewitar\.pl$ [NC]
  RewriteRule ^ https://drewitar.pl%{REQUEST_URI} [R=301,L]
</IfModule>

AddType image/webp .webp
AddType video/mp4 .mp4
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/xml text/plain
</IfModule>
