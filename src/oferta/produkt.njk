---
layout: layouts/base.njk
pagination:
  data: products
  size: 1
  alias: product
permalink: "/oferta/{{ product.slug }}/"
eleventyComputed:
  title: "{{ product.name }}"
  description: "{{ product.short }} Drewitar – tartak Sobień, woj. łódzkie."
---
<section class="page-head grid-bg"><div class="wrap">
  <nav class="crumbs" aria-label="Okruszki"><a href="/">Start</a> / <a href="/oferta/">Oferta</a> / {{ product.category }}</nav>
  <h1 class="reveal">{{ product.name }}</h1>
  <p class="lead reveal">{{ product.short }}</p>
</div></section>
<section class="section wrap split">
  <div class="media reveal"><img src="{{ product.image or ('/assets/img/placeholders/' + product.slug + '.svg') }}" alt="{{ product.name }}" width="1200" height="800"></div>
  <div class="reveal" style="--d:.12s">
    <p class="large-copy">{{ product.description }}</p>
    <ul class="checks">{% for f in product.features %}<li>{{ f }}</li>{% endfor %}</ul>
    <div class="hero-actions">
      <a class="btn" href="/kontakt/?produkt={{ product.slug }}#wycena">Zapytaj o wycenę <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href="tel:{{ company.phones[0].tel }}">{{ company.phones[0].display }}</a>
    </div>
  </div>
</section>
<section class="section wrap">
  <div class="section-head"><h2 class="reveal">Zobacz <em>też</em></h2></div>
  <div class="cards">
    {% for p in products %}{% if p.category == product.category and p.slug != product.slug %}{% include "partials/product-card.njk" %}{% endif %}{% endfor %}
  </div>
</section>
